ARI_BASE_URL=https://your-asterisk-host:8089
ARI_USER=your_ari_user
ARI_PASS=your_ari_password
ARI_VERIFY_SSL=1

# Stasis app name used by ari_wait_record_play.py
STASIS_APP=extmedia-ai
# Bridge type attributes. You can also set BRIDGE_TYPE=softmix (alias to mixing,dtmf_events).
BRIDGE_TYPE=mixing,proxy_media

# Optional override for Python -> Asterisk RTP target.
# If empty/0, script uses UNICASTRTP_LOCAL_ADDRESS/PORT from ARI.
RTP_INJECT_HOST=
RTP_INJECT_PORT=0
RTP_PREROLL_MS=800
CONF_FORCE_SOFTMIX=0
CONF_HELPER_EXTERNAL_HOST=127.0.0.1:9

